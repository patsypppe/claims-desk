# ---- Model / API ----
# "llm" uses a model for extraction + phrasing; "rules" runs fully deterministic (no key needed).
AGENT_MODE=llm
# Provider: anthropic | groq
AI_PROVIDER=anthropic
# API key for the chosen provider (AI_API_KEY is accepted as an alias for either). Never commit a real key.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Response model. Empty = provider default (anthropic: claude-opus-5, groq: openai/gpt-oss-120b).
AI_MODEL=
# Optional separate model for the extraction call (defaults to AI_MODEL).
AI_EXTRACTION_MODEL=
# SDK retries on rate limits / transient errors (raise for free-tier eval runs).
LLM_MAX_RETRIES=3

# ---- Demo / determinism ----
# Pin "today" for deadline logic (ISO date). Empty = real system date.
APP_TODAY=2026-09-28
# Representative consent mock scenario: default | timeout
CONSENT_SCENARIO=default
FIXTURES_DIR=

# ---- SOP thresholds ----
MAX_VERIFICATION_ATTEMPTS=3
OOS_OFFER_THRESHOLD=2
OOS_ESCALATION_THRESHOLD=3
MAX_CLARIFICATIONS=3
LOCKOUT_FAILURES=5
# When true, one of DOB / ID last 4 must be among the matched factors.
REQUIRE_KNOWLEDGE_FACTOR=false

# ---- UI / sessions ----
DEBUG_PANEL=true
SESSION_TTL_MINUTES=30
